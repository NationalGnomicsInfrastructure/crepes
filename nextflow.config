manifest {
    name            = 'nf-core/crepes'
    author          = 'MaxUlysse'
    homePage        = 'https://github.com/nf-core/crepes'
    description     = 'Crepe analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

params {
    recipes          = ''
    outdir           = './results'
    publish_dir_mode = 'copy'
}

includeConfig 'conf/base.config'
includeConfig 'conf/test.config'
